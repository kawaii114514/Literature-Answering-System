# Copy to .env.production and replace every placeholder before deployment.
# This file is safe to commit; .env.production is ignored.

MYSQL_DATABASE=literature
MYSQL_USER=literature
MYSQL_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_URL=jdbc:mysql://mysql:3306/literature?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

QDRANT_HOST=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=literature_passages_bge_m3
QDRANT_INITIALIZE_SCHEMA=true

APP_AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_AUTH_TOKEN_TTL_SECONDS=86400
APP_AUTH_REQUIRED=true
APP_STORAGE_LOCAL_ROOT=/app/data/uploads
APP_STORAGE_LUCENE_ROOT=/app/data/lucene

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_EMBEDDINGS_PATH=/v1/embeddings
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

APP_RETRIEVAL_DEFAULT_STRATEGY=HYBRID_RRF
APP_RETRIEVAL_MIN_SCORE=0.65
