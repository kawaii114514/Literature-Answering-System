MYSQL_URL=jdbc:mysql://localhost:3306/literature?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USER=literature
MYSQL_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
APP_STORAGE_LOCAL_ROOT=./data/uploads
APP_STORAGE_LUCENE_ROOT=./data/lucene
APP_AUTH_SECRET=replace-with-at-least-32-byte-secret
APP_AUTH_TOKEN_TTL_SECONDS=86400
APP_AUTH_REQUIRED=true
# Generic Cohere-compatible reranker settings (override these for a different provider)
# RERANK_ENABLED=false
# RERANK_BASE_URL=http://localhost:8000
# RERANK_API_KEY=
# RERANK_MODEL=rerank-v3.5

# Recommended production profile: SiliconFlow BGE + official DeepSeek Chat
# Do not commit real keys. Set these in the shell or IDE run configuration.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_EMBEDDINGS_PATH=/v1/embeddings
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
